<?xml version="1.0" ?>
<robot name="tool">
  
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

    <link name="base">
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0.0001"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>
  
  <joint name="sensor" type="fixed">
      <parent link="base"/>
      <child link="sensor"/>
      <origin rpy="3.14159  0 -0.785398" xyz="0 0 0"/>
      <dynamics damping="0.5"/>
  </joint>
  
  <link name="sensor">
    <inertial>
      <mass value="0.54" />
      <origin xyz="0.0109695 0.0107965 0.0650411" rpy="0 0 0" />
      <inertia ixx="0.000888868887021" ixy="-0.00012239074652" ixz="3.98699829666e-05" iyy="0.000888001373233" iyz="-9.33825115206e-05" izz="0.0007176834609" />
    </inertial>
    <visual>
      <!-- <origin rpy="0 0 0" xyz="0 0 0"/> -->
      <geometry>
        <mesh filename="stl/visual/link7.dae"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <!-- <origin rpy="0 0 0" xyz="0 0 0"/> -->
      <geometry>
        <mesh filename="stl/collision/link7.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper" type="fixed">
      <parent link="sensor"/>
      <child link="gripper"/>
      <origin rpy="0 0 -0.7853981633974483" xyz="0 0 0.107"/>
      <dynamics damping="0.5"/>
  </joint>

    
  <link name="gripper">
    <inertial>
        <mass value="0.73" />
        <origin xyz="0 0.0015244 0.0275912" rpy="0 0 0" />
        <inertia ixx="0.00278560230025" ixy="0.0" ixz="0.0" iyy="0.000400033405336" iyz="0.0" izz="0.00256378041832" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="stl/visual/hand.dae"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="stl/collision/hand.stl"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="member" type="fixed">
      <parent link="gripper"/>
      <child link="member"/>
      <origin rpy="-3.14159 0 0.58" xyz="0 0 0.15"/>
      <dynamics damping="0.5"/>
  </joint>

  <link name="member">
    <inertial>
      <origin rpy="0 0 0.58" xyz="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0094" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0094"/>
    </inertial>
    <visual>
      <origin rpy="0, 0, 0" xyz="0, 0, 0"/>
      <geometry>
        <mesh filename="stl/collision/peg.stl" scale="0.001 0.001 0.001"/>
      </geometry>
       <material name="white" />
    </visual>
    <collision>
      <origin rpy="0, 0, 0" xyz="0, 0, 0"/>
      <geometry>
           <mesh filename="stl/collision/peg.stl" scale="0.00095 0.00095 0.00095"/>
      </geometry>
    </collision>
  </link>
  
</robot>

